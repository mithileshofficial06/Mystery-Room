# Copy to .env.local and fill in.
#
# Cosmos DB's Mongo API or a plain MongoDB. NOTE: retryWrites MUST stay off
# against Cosmos — it rejects it on WRITE rather than on connect, so everything
# looks healthy until the first team submits an answer (see src/lib/db/client.ts).
MONGODB_URI="mongodb://localhost:27017/?retryWrites=false"
MONGODB_DB="xplore26"

# Signs the session cookie and peppers the answer hash. Changing it after
# seeding invalidates every stored answerHash — reseed if you change it.
SESSION_SECRET="change-me-before-the-event"

# Where scripts/verify-hunt.ts points itself.
HUNT_BASE="http://localhost:3100"
