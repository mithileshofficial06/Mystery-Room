{
  "name": "xplore26-treasure-hunt",
  "version": "1.0.0",
  "private": true,
  "description": "XPLORE'26 treasure hunt — four browser puzzles (cipher, colour grid, circuit, 3D mystery room).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:coins": "tsx --env-file=.env.local scripts/seed-coins.ts",
    "seed:hunt": "tsx --env-file=.env.local scripts/seed-hunt.ts",
    "verify:hunt": "tsx --env-file=.env.local scripts/verify-hunt.ts",
    "shoot": "node scripts/shoot-room.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.0",
    "mongodb": "^6.13.0",
    "next": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.0.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
